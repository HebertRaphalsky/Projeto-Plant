        "# CÉLULA 6 — CARREGAMENTO E NORMALIZAÇÃO\n",
        "IMG_SIZE = (64, 64)\n",
        "\n",
        "X = []\n",
        "y_text = []\n",
        "groups = []\n",
        "\n",
        "for item in imagens_selecionadas:\n",
        "    try:\n",
        "        imagem = item[\"image\"].resize(IMG_SIZE)\n",
        "        arr = np.array(imagem, dtype=np.float32) / 255.0\n",
        "\n",
        "        X.append(arr)\n",
        "        y_text.append(item[\"label\"])\n",
        "        groups.append(item[\"leaf_id\"])\n",
        "\n",
        "    except Exception as erro:\n",
        "        print(\"Erro:\", erro)\n",
        "\n",
        "X = np.array(X, dtype=np.float32)\n",
        "y_text = np.array(y_text)\n",
        "groups = np.array(groups)\n",
        "\n",
        "print(\"Dimensão de X:\", X.shape)\n",
        "print(\"Dimensão de y:\", y_text.shape)\n",
        "print(\"Quantidade de grupos/folhas:\", len(np.unique(groups)))\n",
        "print(\"Valores ausentes em X:\", np.isnan(X).sum())"
      ]
