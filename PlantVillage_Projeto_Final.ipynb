      "source": [
        "# Mantém a estratificação das classes e separa grupos de folhas para reduzir vazamento.\n",
        "# Divisão estratificada mantendo grupos de folhas separados entre treino e teste.\n",
        "# CÉLULA 11 — TREINO/TESTE SEM VAZAMENTO DE DADOS\n",
        "# As imagens da mesma folha não podem aparecer simultaneamente\n",
        "# nos conjuntos de treino e teste.\n",
        "\n",
        "sgkf = StratifiedGroupKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "train_idx, test_idx = next(\n",
        "    sgkf.split(X, y, groups=groups)\n",
        ")\n",
        "\n",
        "X_train_img = X[train_idx]\n",
        "X_test_img = X[test_idx]\n",
        "y_train = y[train_idx]\n",
        "y_test = y[test_idx]\n",
        "\n",
        "groups_train = groups[train_idx]\n",
        "groups_test = groups[test_idx]\n",
        "\n",
        "print(\"Treino:\", X_train_img.shape)\n",
        "print(\"Teste:\", X_test_img.shape)\n",
        "print(\"Folhas no treino:\", len(np.unique(groups_train)))\n",
        "print(\"Folhas no teste:\", len(np.unique(groups_test)))\n",
        "print(\n",
