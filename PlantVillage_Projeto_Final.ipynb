        "# CÉLULA 9 — NOMES PARA VISUALIZAÇÃO\n",
        "nomes_classes_pt = {\n",
        "    \"Pepper,_bell___Bacterial_spot\": \"Pimentão — Mancha bacteriana\",\n",
        "    \"Pepper,_bell___healthy\": \"Pimentão — Saudável\",\n",
        "    \"Potato___Early_blight\": \"Batata — Requeima precoce\",\n",
