      "source": [
        "# CÉLULA 5 — SELEÇÃO BALANCEADA\n",
        "imagens_por_classe = {classe: [] for classe in CLASSES_DESEJADAS}\n",
        "contador_total = 0\n",
        "\n",
        "for exemplo in dataset:\n",
        "    classe = exemplo.get(\"class_label\")\n",
        "    if classe not in CLASSES_DESEJADAS:\n",
        "        continue\n",
        "    if len(imagens_por_classe[classe]) >= MAX_IMAGES_PER_CLASS:\n",
        "        continue\n",
        "\n",
        "    imagem = exemplo.get(\"image\")\n",
        "    leaf_id = exemplo.get(\"leaf_id\")\n",
        "\n",
        "    if imagem is None:\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        imagem = imagem.convert(\"RGB\")\n",
        "    except Exception:\n",
        "        continue\n",
        "\n",
        "    imagens_por_classe[classe].append({\n",
        "        \"image\": imagem,\n",
        "        \"leaf_id\": leaf_id\n",
        "    })\n",
        "\n",
        "    contador_total += 1\n",
        "\n",
        "    if contador_total % 100 == 0:\n",
        "        print(\"Imagens coletadas:\", contador_total)\n",
        "\n",
        "    if all(\n",
        "        len(imagens_por_classe[c]) >= MAX_IMAGES_PER_CLASS\n",
        "        for c in CLASSES_DESEJADAS\n",
        "    ):\n",
        "        break\n",
        "\n",
        "imagens_selecionadas = []\n",
        "\n",
        "for classe in CLASSES_DESEJADAS:\n",
        "    quantidade = len(imagens_por_classe[classe])\n",
        "    print(f\"{classe}: {quantidade}\")\n",
        "\n",
        "    for item in imagens_por_classe[classe]:\n",
        "        imagens_selecionadas.append({\n",
        "            \"image\": item[\"image\"],\n",
        "            \"label\": classe,\n",
        "            \"leaf_id\": item[\"leaf_id\"]\n",
        "        })\n",
        "\n",
        "print(\"Total:\", len(imagens_selecionadas))\n",
        "\n",
        "if not imagens_selecionadas:\n",
        "    raise RuntimeError(\"Nenhuma imagem foi selecionada.\")"
      ]
